# Where the FastAPI service lives. Copy to .env.local and edit.
#
# next dev    — leave unset; core.ts falls back to http://localhost:8000
# next build  — set it, unless you serve app/out from FastAPI itself
# Capacitor   — REQUIRED, and must be HTTPS on a real device. The bundle loads
#               from file://, and "localhost" on a phone is the phone.
NEXT_PUBLIC_API_BASE=http://localhost:8000
