{
  "name": "productcapture-app",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js + Capacitor shell for the Product Capture SDK",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
